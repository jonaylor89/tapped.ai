# Example environment for a manual run on your laptop. Copy to ~/.config/tapped/event-scraper.env (chmod 600)
# and load it with: set -a; source ~/.config/tapped/event-scraper.env; set +a
# Never commit real values.
EVENT_SCRAPER_CONFIG=~/.config/tapped/event-scraper.config.json
# Required: the tapped_scraper role on production Postgres, through the tunnel described in the README.
# EVENT_SCRAPER_DATABASE_URL=postgres://tapped_scraper:...@127.0.0.1:55433/tapped
# Publishing: off | ndjson (default, local dry run) | postgres (production; needs INGESTION_DATABASE_URL + SCRAPE_R2_*)
EVENT_SCRAPER_PUBLISH=ndjson
# Features (defaults shown): OSM + listings on; Places, LLM and Bandsintown off.
EVENT_SCRAPER_OSM=1
EVENT_SCRAPER_LISTINGS=1
EVENT_SCRAPER_PLACES=0
EVENT_SCRAPER_LLM=0
EVENT_SCRAPER_BANDSINTOWN=0
# Secrets (set only for enabled features):
# OPENAI_API_KEY=
# EVENT_SCRAPER_LLM_MODEL=gpt-4o-mini
# GOOGLE_PLACES_API_KEY=
# BANDSINTOWN_APP_ID=
# INGESTION_DATABASE_URL=
# SCRAPE_R2_* also holds raw pages. Without it they stay on this laptop's disk, which is only good for dry runs.
# SCRAPE_R2_ACCOUNT_ID=
# SCRAPE_R2_BUCKET=
# SCRAPE_R2_ACCESS_KEY_ID=
# SCRAPE_R2_SECRET_ACCESS_KEY=
