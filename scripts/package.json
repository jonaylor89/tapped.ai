{
  "name": "tapped-data-cutover",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "crawler:resolve-venues": "ts-node --compiler-options '{\"module\":\"CommonJS\",\"esModuleInterop\":true,\"skipLibCheck\":true}' resolve_scrape_venues.ts",
    "crawler:import-r2": "ts-node --compiler-options '{\"module\":\"CommonJS\",\"esModuleInterop\":true,\"skipLibCheck\":true}' import_r2_crawler.ts",
    "typecheck": "tsc --noEmit --target es2020 --module commonjs --moduleResolution node --esModuleInterop --skipLibCheck --types node resolve_scrape_venues.ts import_r2_crawler.ts"
  },
  "dependencies": {
    "pg": "8.13.1",
    "redis": "4.7.0"
  },
  "devDependencies": {
    "@types/node": "20.10.7",
    "@types/pg": "8.11.10",
    "ts-node": "10.9.2",
    "typescript": "4.9.5"
  }
}
