# Copy to .env.local and fill these public client values from Vercel's
# app-tapped-ai Development environment or your own Firebase/Mapbox projects.
# Never place server credentials, service-account keys, or private API keys here.
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_IMAGE_PROXY_URL=https://img.tapped.ai
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Public application API (defaults to production). Reads use real public data;
# authenticated actions against production affect real accounts.
NEXT_PUBLIC_TAPPED_API_URL=https://api.tapped.ai

# Optional analytics; leave blank for local development.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
