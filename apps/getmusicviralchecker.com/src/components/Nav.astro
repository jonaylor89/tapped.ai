---

---

<nav class="fixed flex flex-wrap items-center bg-transparent p-3">
	<a
		href="https://tapped.ai"
		target="_blank"
		rel="noopener noreferrer"
		class="mr-4 inline-flex items-center p-2"
	>
		<img src="/images/icon_1024.png" width="75" height="75" alt="tapped logo" />
		<div class="w-6"></div>
		<span class="text-xl font-bold uppercase tracking-wide text-black"> TAPPED AI </span>
	</a>
	<button
		id="nav-toggle"
		class="ml-auto inline-flex rounded p-3 text-black outline-none hover:bg-blue-500 hover:text-black lg:hidden"
		aria-label="Toggle navigation"
	>
		<svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
			<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
		</svg>
	</button>
	<div id="nav-menu" class="hidden w-full lg:inline-flex lg:w-auto lg:flex-grow">
		<div
			class="flex w-full flex-col items-start lg:ml-auto lg:inline-flex lg:h-auto lg:w-auto lg:flex-row lg:items-center"
		>
			<a
				href="https://tapped.ai"
				target="_blank"
				rel="noopener noreferrer"
				class="w-full items-center justify-center rounded px-3 py-2 font-bold text-black hover:bg-blue-500 hover:text-black lg:inline-flex lg:w-auto"
			>
				home
			</a>
			<a
				href="https://getmusicmarketing.com"
				target="_blank"
				rel="noopener noreferrer"
				class="w-full items-center justify-center rounded px-3 py-2 font-bold text-black hover:bg-blue-500 hover:text-black lg:inline-flex lg:w-auto"
			>
				marketing
			</a>
			<a
				href="https://viralsocialmediaideas.com"
				target="_blank"
				rel="noopener noreferrer"
				class="w-full items-center justify-center rounded px-3 py-2 font-bold text-black hover:bg-blue-500 hover:text-black lg:inline-flex lg:w-auto"
			>
				social media
			</a>
			<a
				href="https://getmusicnewsletters.com"
				target="_blank"
				rel="noopener noreferrer"
				class="w-full items-center justify-center rounded px-3 py-2 font-bold text-black hover:bg-blue-500 hover:text-black lg:inline-flex lg:w-auto"
			>
				newsletter
			</a>
			<a
				href="mailto://support@tapped.ai"
				class="w-full items-center justify-center rounded px-3 py-2 font-bold text-black hover:bg-blue-500 hover:text-black lg:inline-flex lg:w-auto"
			>
				contact us
			</a>
		</div>
	</div>
</nav>

<script>
	const toggle = document.getElementById("nav-toggle");
	const menu = document.getElementById("nav-menu");
	toggle?.addEventListener("click", () => {
		menu?.classList.toggle("hidden");
	});
</script>
